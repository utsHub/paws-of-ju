```html
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JU Animal Health & Awareness Day</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-white text-gray-900 antialiased">

    <!-- Hero Section -->
    <section class="py-24 bg-white border-b border-gray-100">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h1 class="text-5xl font-extrabold text-gray-950 mb-6 leading-tight">
                JU Campus Animal Health & Awareness Day
            </h1>
            <p class="text-xl text-gray-600 mb-10">Supporting compassionate care and sustainable coexistence on campus.</p>
        </div>
    </section>

    <!-- Sponsorship Section -->
    <section id="sponsorship" class="py-24 bg-white">
        <div class="max-w-6xl mx-auto px-6">
            <h2 class="text-3xl font-bold mb-16 text-center">Sponsorship Tiers</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Tier 1: Guardian -->
                <div class="p-8 border-2 border-emerald-600 rounded-2xl">
                    <h3 class="text-xl font-bold mb-2">Guardian</h3>
                    <p class="text-4xl font-extrabold mb-6">150,000 BDT</p>
                    <button onclick="openForm('Guardian')" class="w-full py-3 bg-emerald-600 text-white rounded-lg font-semibold hover:bg-emerald-700">Support Now</button>
                </div>
                
                <!-- Tier 2: Voice -->
                <div class="p-8 border border-gray-200 rounded-2xl">
                    <h3 class="text-xl font-bold mb-2">Voice</h3>
                    <p class="text-4xl font-extrabold mb-6">100,000 BDT</p>
                    <button onclick="openForm('Voice')" class="w-full py-3 bg-gray-900 text-white rounded-lg font-semibold hover:bg-gray-700">Support Now</button>
                </div>

                <!-- Tier 3: Pawprint -->
                <div class="p-8 border border-gray-200 rounded-2xl">
                    <h3 class="text-xl font-bold mb-2">Pawprint</h3>
                    <p class="text-4xl font-extrabold mb-6">50,000 BDT</p>
                    <button onclick="openForm('Pawprint')" class="w-full py-3 bg-gray-900 text-white rounded-lg font-semibold hover:bg-gray-700">Support Now</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Support Modal Form -->
    <div id="pledgeModal" class="fixed inset-0 bg-gray-900/40 hidden flex items-center justify-center p-6 z-[100]">
        <div class="bg-white p-8 rounded-2xl max-w-sm w-full shadow-2xl">
            <h2 class="text-xl font-bold mb-6">Confirm Sponsorship</h2>
            <!-- Connected to your SheetMonkey Endpoint -->
            <form action="https://api.sheetmonkey.io/form/jyW5kpZyH7JBgM5VAeWbZk" method="POST">
                <input type="text" name="Name" placeholder="Your Name or Organization" required class="w-full p-4 mb-3 border border-gray-200 rounded-lg">
                <input type="email" name="Email" placeholder="Email Address" required class="w-full p-4 mb-3 border border-gray-200 rounded-lg">
                <input type="text" id="tierInput" name="Tier" readonly class="w-full p-4 mb-6 border border-gray-200 rounded-lg bg-gray-50 font-bold">
                <button type="submit" class="w-full py-4 bg-emerald-600 text-white rounded-lg font-bold">Submit Pledge</button>
                <button type="button" onclick="closeForm()" class="w-full mt-4 text-sm text-gray-500 underline">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        function openForm(tier) {
            document.getElementById('pledgeModal').classList.remove('hidden');
            document.getElementById('tierInput').value = tier;
        }
        function closeForm() {
            document.getElementById('pledgeModal').classList.add('hidden');
        }
    </script>
</body>
</html>


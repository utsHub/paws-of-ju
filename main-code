<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JU Campus Animal Health & Awareness Day</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
  :root {
    --forest: #1a4731;
    --sage: #2d6a4f;
    --mint: #52b788;
    --cream: #f8f4ed;
    --warm-white: #fdfcf9;
    --charcoal: #1c1c1c;
    --gold: #c9a84c;
  }

  * { box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--warm-white);
    color: var(--charcoal);
    overflow-x: hidden;
  }

  h1, h2, h3, .serif { font-family: 'Playfair Display', serif; }

  /* ── Reading progress bar ── */
  #progress-bar {
    position: fixed; top: 0; left: 0; height: 3px;
    background: linear-gradient(90deg, var(--mint), var(--gold));
    width: 0%; z-index: 9999; transition: width 0.1s linear;
  }

  /* ── Nav ── */
  nav {
    position: fixed; top: 3px; width: 100%; z-index: 999;
    background: rgba(253,252,249,.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(82,183,136,.15);
    transition: box-shadow .3s;
  }
  nav.scrolled { box-shadow: 0 4px 30px rgba(26,71,49,.08); }

  /* ── Scroll reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .reveal.visible { opacity: 1; transform: none; }
  .reveal-delay-1 { transition-delay: .1s; }
  .reveal-delay-2 { transition-delay: .2s; }
  .reveal-delay-3 { transition-delay: .3s; }
  .reveal-delay-4 { transition-delay: .4s; }
  .reveal-delay-5 { transition-delay: .5s; }

  /* ── Hero ── */
  .hero-bg {
    background: linear-gradient(160deg, var(--forest) 0%, #2d6a4f 55%, #40916c 100%);
    position: relative;
    overflow: hidden;
  }
  .hero-bg::before {
    content: '';
    position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2352b788' fill-opacity='0.07'%3E%3Ccircle cx='30' cy='30' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: .6;
  }
  .hero-blob {
    position: absolute; border-radius: 50%;
    filter: blur(80px); opacity: .18;
    animation: drift 10s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from { transform: translate(0,0) scale(1); }
    to   { transform: translate(30px, -20px) scale(1.05); }
  }

  /* ── Stat cards ── */
  .stat-card {
    background: white;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid rgba(82,183,136,.15);
    box-shadow: 0 2px 20px rgba(26,71,49,.06);
    transition: transform .3s, box-shadow .3s;
    cursor: default;
  }
  .stat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(26,71,49,.12);
  }

  /* ── Activity tabs ── */
  .tab-btn {
    padding: .65rem 1.4rem;
    border-radius: 50px;
    font-size: .875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all .25s;
    border: 1.5px solid transparent;
    white-space: nowrap;
    background: white;
    color: #555;
    border-color: #e5e7eb;
  }
  .tab-btn.active {
    background: var(--forest);
    color: white;
    border-color: var(--forest);
    box-shadow: 0 4px 16px rgba(26,71,49,.25);
  }
  .tab-panel { display: none; animation: fadeIn .4s ease; }
  .tab-panel.active { display: grid; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* ── Budget bars ── */
  .budget-bar-fill {
    height: 100%;
    border-radius: 6px;
    width: 0%;
    transition: width 1.4s cubic-bezier(.4,0,.2,1);
  }

  /* ── Timeline ── */
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 20px; top: 44px;
    width: 2px;
    height: calc(100% + 1rem);
    background: linear-gradient(to bottom, var(--mint), transparent);
  }
  .timeline-item:last-child::before { display: none; }

  /* ── Sponsor tiers ── */
  .tier-card {
    border-radius: 20px;
    padding: 2rem;
    transition: transform .3s, box-shadow .3s;
    cursor: default;
    position: relative;
    overflow: hidden;
  }
  .tier-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0,0,0,.12);
  }

  /* ── Modal ── */
  #support-modal {
    display: none;
    position: fixed; inset: 0; z-index: 10000;
    background: rgba(10,20,15,.7);
    backdrop-filter: blur(6px);
    align-items: center; justify-content: center;
    padding: 1rem;
  }
  #support-modal.open { display: flex; }
  .modal-card {
    background: white;
    border-radius: 24px;
    max-width: 520px;
    width: 100%;
    padding: 2.5rem;
    position: relative;
    animation: popIn .35s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes popIn {
    from { opacity: 0; transform: scale(.85); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* ── Paw cursor trail ── */
  .trail-dot {
    position: fixed;
    width: 8px; height: 8px;
    background: var(--mint);
    border-radius: 50%;
    pointer-events: none;
    z-index: 99998;
    transform: translate(-50%,-50%);
    opacity: 0;
    transition: opacity .3s;
  }

  /* ── Accordion ── */
  .faq-body { max-height: 0; overflow: hidden; transition: max-height .4s ease, padding .3s; }
  .faq-body.open { max-height: 300px; }

  /* ── Button ── */
  .btn-primary {
    background: var(--forest);
    color: white;
    padding: .85rem 2.2rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: .95rem;
    cursor: pointer;
    border: none;
    transition: background .25s, transform .2s, box-shadow .25s;
    display: inline-block;
  }
  .btn-primary:hover {
    background: var(--sage);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26,71,49,.3);
  }
  .btn-outline {
    background: transparent;
    color: var(--forest);
    padding: .85rem 2.2rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: .95rem;
    cursor: pointer;
    border: 2px solid var(--forest);
    transition: all .25s;
    display: inline-block;
  }
  .btn-outline:hover { background: var(--forest); color: white; }

  /* ── Tags ── */
  .badge {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .75rem; font-weight: 600; letter-spacing: .07em;
    text-transform: uppercase;
    padding: .35rem .9rem;
    border-radius: 50px;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--cream); }
  ::-webkit-scrollbar-thumb { background: var(--mint); border-radius: 3px; }

  /* Mobile tweaks */
  @media (max-width: 640px) {
    h1 { font-size: 2.6rem !important; }
    .hero-stat-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
<body>

<!-- Reading progress -->
<div id="progress-bar"></div>

<!-- ═══════════════════════════════ NAV ═══════════════════════════════ -->
<nav id="main-nav">
  <div style="max-width:1280px;margin:auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:68px;">
    <div style="display:flex;align-items:center;gap:.6rem;cursor:pointer" onclick="window.scrollTo({top:0,behavior:'smooth'})">
      <span style="font-size:1.6rem;">🐾</span>
      <span style="font-family:'Playfair Display',serif;font-weight:700;font-size:1.1rem;color:var(--forest)">JU Animal Welfare</span>
    </div>
    <div class="hidden md:flex" style="gap:1.5rem;align-items:center">
      <a href="#about"       style="font-size:.875rem;font-weight:500;color:#555;text-decoration:none;transition:color .2s" onmouseover="this.style.color='var(--forest)'" onmouseout="this.style.color='#555'">About</a>
      <a href="#problem"     style="font-size:.875rem;font-weight:500;color:#555;text-decoration:none;transition:color .2s" onmouseover="this.style.color='var(--forest)'" onmouseout="this.style.color='#555'">The Problem</a>
      <a href="#activities"  style="font-size:.875rem;font-weight:500;color:#555;text-decoration:none;transition:color .2s" onmouseover="this.style.color='var(--forest)'" onmouseout="this.style.color='#555'">Activities</a>
      <a href="#schedule"    style="font-size:.875rem;font-weight:500;color:#555;text-decoration:none;transition:color .2s" onmouseover="this.style.color='var(--forest)'" onmouseout="this.style.color='#555'">Schedule</a>
      <a href="#budget"      style="font-size:.875rem;font-weight:500;color:#555;text-decoration:none;transition:color .2s" onmouseover="this.style.color='var(--forest)'" onmouseout="this.style.color='#555'">Budget</a>
      <a href="#faq"         style="font-size:.875rem;font-weight:500;color:#555;text-decoration:none;transition:color .2s" onmouseover="this.style.color='var(--forest)'" onmouseout="this.style.color='#555'">FAQ</a>
      <button class="btn-primary" onclick="openModal()" style="padding:.6rem 1.6rem;font-size:.875rem;">💚 Support Us</button>
    </div>
    <button class="md:hidden" onclick="toggleMobileMenu()" style="background:none;border:none;font-size:1.4rem;cursor:pointer;">☰</button>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-nav" style="display:none;padding:1rem 1.5rem 1.5rem;border-top:1px solid #eee;background:white;">
    <div style="display:flex;flex-direction:column;gap:.5rem">
      <a href="#about"      onclick="closeMobileMenu()" style="padding:.7rem 1rem;border-radius:10px;color:#333;text-decoration:none;font-weight:500;transition:background .2s" onmouseover="this.style.background='#f0faf5'" onmouseout="this.style.background='none'">About</a>
      <a href="#problem"    onclick="closeMobileMenu()" style="padding:.7rem 1rem;border-radius:10px;color:#333;text-decoration:none;font-weight:500" onmouseover="this.style.background='#f0faf5'" onmouseout="this.style.background='none'">The Problem</a>
      <a href="#activities" onclick="closeMobileMenu()" style="padding:.7rem 1rem;border-radius:10px;color:#333;text-decoration:none;font-weight:500" onmouseover="this.style.background='#f0faf5'" onmouseout="this.style.background='none'">Activities</a>
      <a href="#schedule"   onclick="closeMobileMenu()" style="padding:.7rem 1rem;border-radius:10px;color:#333;text-decoration:none;font-weight:500" onmouseover="this.style.background='#f0faf5'" onmouseout="this.style.background='none'">Schedule</a>
      <a href="#budget"     onclick="closeMobileMenu()" style="padding:.7rem 1rem;border-radius:10px;color:#333;text-decoration:none;font-weight:500" onmouseover="this.style.background='#f0faf5'" onmouseout="this.style.background='none'">Budget</a>
      <a href="#faq"        onclick="closeMobileMenu()" style="padding:.7rem 1rem;border-radius:10px;color:#333;text-decoration:none;font-weight:500" onmouseover="this.style.background='#f0faf5'" onmouseout="this.style.background='none'">FAQ</a>
      <button class="btn-primary" onclick="openModal();closeMobileMenu()" style="margin-top:.5rem;">💚 Support Us</button>
    </div>
  </div>
</nav>

<!-- ═══════════════════════════════ HERO ═══════════════════════════════ -->
<section class="hero-bg" style="min-height:100vh;display:flex;align-items:center;padding-top:72px;position:relative;">
  <!-- Decorative blobs -->
  <div class="hero-blob" style="width:500px;height:500px;background:#52b788;top:-100px;right:-80px;"></div>
  <div class="hero-blob" style="width:300px;height:300px;background:#c9a84c;bottom:50px;left:-60px;animation-delay:-5s;"></div>

  <div style="max-width:1280px;margin:auto;padding:4rem 1.5rem;width:100%;position:relative;z-index:2;">
    <div style="max-width:750px">
      <div class="badge reveal" style="background:rgba(82,183,136,.2);color:#b7e4c7;border:1px solid rgba(82,183,136,.3);margin-bottom:1.5rem;">
        <span>🐾</span> Funding Proposal · PETA JU Team
      </div>
      <h1 class="reveal reveal-delay-1" style="font-size:clamp(2.8rem,6vw,5rem);color:white;line-height:1.1;margin-bottom:1.5rem;font-weight:900;">
        Protect.<br>Learn.<br><span style="color:#b7e4c7;">Coexist.</span>
      </h1>
      <p class="reveal reveal-delay-2" style="color:rgba(255,255,255,.75);font-size:1.15rem;line-height:1.7;max-width:540px;margin-bottom:2.5rem;font-weight:300;">
        JU Campus Animal Health & Awareness Day — a one-day initiative uniting preventive healthcare, education, and community action at Jahangirnagar University.
      </p>
      <div class="reveal reveal-delay-3" style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:4rem;">
        <button class="btn-primary" onclick="openModal()">💚 Become a Donor</button>
        <a href="#about" class="btn-outline" style="border-color:rgba(255,255,255,.5);color:white;text-decoration:none;">View Proposal ↓</a>
      </div>

      <!-- Hero stats -->
      <div class="hero-stat-grid reveal reveal-delay-4" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;max-width:600px">
        <div style="background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.15);border-radius:16px;padding:1.2rem 1rem;text-align:center;">
          <div style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:white" data-count="250000" data-prefix="৳" data-suffix="k" data-divide="1000">0</div>
          <div style="font-size:.75rem;color:rgba(255,255,255,.6);margin-top:.2rem;font-weight:500">Budget Goal</div>
        </div>
        <div style="background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.15);border-radius:16px;padding:1.2rem 1rem;text-align:center;">
          <div style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:white" data-count="50">0</div>
          <div style="font-size:.75rem;color:rgba(255,255,255,.6);margin-top:.2rem;font-weight:500">Dogs to Vaccinate</div>
        </div>
        <div style="background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.15);border-radius:16px;padding:1.2rem 1rem;text-align:center;">
          <div style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:white" data-count="6">0</div>
          <div style="font-size:.75rem;color:rgba(255,255,255,.6);margin-top:.2rem;font-weight:500">Core Objectives</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div style="position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);text-align:center;z-index:2;animation:bounce 2s infinite;">
    <div style="color:rgba(255,255,255,.5);font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.5rem;">Scroll</div>
    <div style="color:rgba(255,255,255,.4);font-size:1.2rem;">↓</div>
  </div>
  <style>@keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}</style>
</section>

<!-- ═══════════════════════════════ ABOUT ═══════════════════════════════ -->
<section id="about" style="padding:6rem 1.5rem;background:var(--warm-white);">
  <div style="max-width:1280px;margin:auto;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center" class="responsive-grid">
      <div>
        <div class="badge reveal" style="background:#e8f5ee;color:var(--sage);margin-bottom:1rem;">Executive Summary</div>
        <h2 class="reveal reveal-delay-1" style="font-size:clamp(2rem,3.5vw,2.8rem);margin-bottom:1.5rem;line-height:1.2;">A Unique Ecological<br>Responsibility</h2>
        <p class="reveal reveal-delay-2" style="color:#666;line-height:1.8;font-size:1.05rem;margin-bottom:1rem;">
          Jahangirnagar University is a shared living space where humans, community dogs, cats, and birds coexist daily. This ecosystem carries responsibility — one that requires structured, compassionate intervention.
        </p>
        <p class="reveal reveal-delay-3" style="color:#666;line-height:1.8;font-size:1.05rem;margin-bottom:2rem;">
          Recent suspected distemper outbreaks have resulted in animal deaths and raised urgent welfare concerns. Without immediate action, preventable diseases will spread and suffering will escalate.
        </p>
        <div class="reveal reveal-delay-4" style="background:linear-gradient(135deg,#e8f5ee,#f0faf5);border-left:4px solid var(--mint);border-radius:0 12px 12px 0;padding:1.2rem 1.5rem;display:flex;align-items:flex-start;gap:1rem;">
          <span style="font-size:1.5rem;flex-shrink:0;">🛡️</span>
          <p style="font-size:.9rem;font-weight:600;color:var(--forest);line-height:1.6;">Organized by <strong>PETA – Jahangirnagar University Team</strong>. An all-day campus initiative integrating healthcare, awareness, and long-term student engagement.</p>
        </div>
      </div>
      <div class="reveal reveal-delay-2" style="position:relative;">
        <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&q=80&w=800" alt="University campus" style="border-radius:24px;width:100%;height:420px;object-fit:cover;box-shadow:0 24px 60px rgba(26,71,49,.15);">
        <!-- Floating card -->
        <div style="position:absolute;bottom:-1.5rem;right:-1.5rem;background:white;border-radius:16px;padding:1.2rem 1.5rem;box-shadow:0 8px 30px rgba(0,0,0,.1);max-width:220px;">
          <div style="display:flex;align-items:center;gap:.7rem;margin-bottom:.5rem;">
            <div style="width:36px;height:36px;background:#e8f5ee;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;">🎓</div>
            <span style="font-weight:700;font-size:.9rem;">Student-Led</span>
          </div>
          <p style="font-size:.8rem;color:#777;line-height:1.5;">Powered by passionate JU students committed to campus animal welfare.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ PROBLEM / OBJECTIVES ═══════════════════════════════ -->
<section id="problem" style="padding:6rem 1.5rem;background:var(--cream);">
  <div style="max-width:1280px;margin:auto;">
    <div class="reveal" style="text-align:center;max-width:640px;margin:0 auto 4rem;">
      <div class="badge" style="background:#fdecea;color:#c0392b;margin-bottom:1rem;">⚠️ The Problem</div>
      <h2 style="font-size:clamp(2rem,3.5vw,2.8rem);margin-bottom:1rem;line-height:1.2;">Why This Is Urgent</h2>
      <p style="color:#666;line-height:1.8;font-size:1.05rem;">Recent suspected distemper cases among campus dogs have caused deaths and raised severe welfare concerns. Without intervention, preventable diseases may spread campus-wide.</p>
    </div>

    <!-- 6 objective cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;">
      <!-- 1 -->
      <div class="stat-card reveal" style="border-top:3px solid #3b82f6;">
        <div style="font-size:2rem;margin-bottom:1rem;">💉</div>
        <h3 style="font-size:1.15rem;font-weight:700;margin-bottom:.5rem;">Vaccination Drive</h3>
        <p style="color:#666;font-size:.9rem;line-height:1.6;">Vaccinate community dogs against distemper, rabies, and other preventable, deadly diseases.</p>
      </div>
      <!-- 2 -->
      <div class="stat-card reveal reveal-delay-1" style="border-top:3px solid #10b981;">
        <div style="font-size:2rem;margin-bottom:1rem;">🩺</div>
        <h3 style="font-size:1.15rem;font-weight:700;margin-bottom:.5rem;">Health Assessments</h3>
        <p style="color:#666;font-size:.9rem;line-height:1.6;">Comprehensive health screenings and basic treatments for all on-campus animals by licensed vets.</p>
      </div>
      <!-- 3 -->
      <div class="stat-card reveal reveal-delay-2" style="border-top:3px solid #f59e0b;">
        <div style="font-size:2rem;margin-bottom:1rem;">📖</div>
        <h3 style="font-size:1.15rem;font-weight:700;margin-bottom:.5rem;">